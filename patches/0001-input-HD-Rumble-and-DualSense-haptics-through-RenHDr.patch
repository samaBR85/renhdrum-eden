++// HD Rumble merge state (eden-hdr, port of Ryuhdr's SDL2 patch), used by no-queue and Bluetooth after input.
++// Only touched with the joysticks locked (SendJoystickEffect, UpdateDevice, the exports).
++typedef struct
++{
++    bool dirty;           // acc holds data that was not written yet
++    Uint8 acc[8];         // peak of everything received since the last real write
++    Uint8 latest[8];      // newest packet from the game
++    Uint8 sent[8];        // last packet written
++    Uint64 last_report_us;
++    Uint64 last_send_us;
++    Uint32 nq_gap_us;     // no-queue: minimum gap between writes
++} HDSyncState;
