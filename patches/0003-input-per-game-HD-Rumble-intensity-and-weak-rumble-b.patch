+    // Gain, then a power curve that lifts weak vibrations more than strong ones (exponent 1.0
+    // at boost 0 down to 0.4 at boost 100). Below a small knee the curve turns quadratic, so the
+    // near-silent values games send between hits do not become a constant buzz.
+    static float ShapeAmplitude(float amplitude, const RenHDrumUserSettings& u) {
+        float x = (std::min)(amplitude * static_cast<float>(u.gain) / 100.0f, 1.0f);
+        if (x <= 0.0f || u.low_boost <= 0) {
+            return x;
+        }
+        const float exponent = 1.0f - 0.006f * static_cast<float>(u.low_boost);
+        constexpr float knee = 0.02f;
+        if (x < knee) {
+            const float r = x / knee;
+            return std::pow(knee, exponent) * r * r;
+        }
+        return std::pow(x, exponent);
+    }
+
     // Caller holds renhdrum_mutex. Picks up changes made in the HD Rumble dialog.
